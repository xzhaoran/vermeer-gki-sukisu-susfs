# Options layered on top of the stock gki_defconfig.
# Each line is passed verbatim to scripts/config, e.g. "-e FOO" or "--set-str BAR baz".

# ThinLTO instead of the vendor FullLTO: same KMI/ABI, much faster and lighter link.
-d LTO_CLANG_FULL
-e LTO_CLANG_THIN

# SukiSU-Nova (built-in root)
-e KSU

# SUSFS v2.4.0
-e KSU_SUSFS
-e KSU_SUSFS_SUS_PATH
-e KSU_SUSFS_SUS_MOUNT
-e KSU_SUSFS_SUS_KSTAT
-e KSU_SUSFS_SPOOF_UNAME
-e KSU_SUSFS_ENABLE_LOG
-e KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
-e KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
-e KSU_SUSFS_OPEN_REDIRECT
-e KSU_SUSFS_SUS_MAP
-e KSU_SUSFS_PRIORITY_UID_FILTER

# KPM: KernelPatch bridge (the kpimg itself is injected into boot.img later)
-e KPM

# Keep the release string fully pinned; setlocalversion must not append -dirty etc.
-d LOCALVERSION_AUTO
